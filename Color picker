<!DOCTYPE html><html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Color Picker</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f4f4;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
    }.container {
  background: white;
  padding: 24px;
  border-radius: 20px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
  max-width: 420px;
  width: 100%;
  text-align: center;
}

h1 {
  margin-top: 0;
  font-size: 24px;
}

.palette {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
  margin: 24px 0;
}

.color {
  width: 56px;
  height: 56px;
  border-radius: 14px;
  border: 3px solid transparent;
  cursor: pointer;
  transition: transform 0.2s, border 0.2s;
  margin: auto;
}

.color:hover {
  transform: scale(1.08);
}

.color.active {
  border: 3px solid #222;
}

.result {
  margin-top: 20px;
  padding: 16px;
  border-radius: 14px;
  background: #f7f7f7;
  display: none;
}

.result h2 {
  margin: 0 0 8px;
  font-size: 20px;
}

.price {
  font-size: 28px;
  font-weight: bold;
  color: #1f7a1f;
}

.instructions {
  color: #666;
  font-size: 14px;
}

  </style>
</head>
<body>
  <div class="container">
    <h1>Choose Your Color</h1>
    <p class="instructions">Tap a color to see the price.</p><div class="palette" id="palette"></div>

<div class="result" id="result">
  <h2 id="colorName"></h2>
  <div class="price" id="colorPrice"></div>
</div>

  </div>  <script>
    const colors = [
      { name: 'White', hex: '#ffffff', price: 'R120' },
      { name: 'Black', hex: '#000000', price: 'R120' },
      { name: 'Red', hex: '#e53935', price: 'R140' },
      { name: 'Blue', hex: '#1e88e5', price: 'R140' },
      { name: 'Green', hex: '#43a047', price: 'R140' },
      { name: 'Yellow', hex: '#fdd835', price: 'R150' },
      { name: 'Orange', hex: '#fb8c00', price: 'R150' },
      { name: 'Grey', hex: '#757575', price: 'R130' },
      { name: 'Brown', hex: '#6d4c41', price: 'R130' },
      { name: 'Silver', hex: '#c0c0c0', price: 'R160' }
    ];

    const palette = document.getElementById('palette');
    const result = document.getElementById('result');
    const colorName = document.getElementById('colorName');
    const colorPrice = document.getElementById('colorPrice');

    colors.forEach(color => {
      const div = document.createElement('div');
      div.className = 'color';
      div.style.background = color.hex;

      if (color.hex === '#ffffff') {
        div.style.border = '1px solid #ccc';
      }

      div.onclick = () => {
        document.querySelectorAll('.color').forEach(c => c.classList.remove('active'));
        div.classList.add('active');

        colorName.textContent = color.name;
        colorPrice.textContent = color.price;
        result.style.display = 'block';
      };

      palette.appendChild(div);
    });
  </script></body>
</html>
